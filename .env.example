# Keine Werte committen. Kopieren nach .env.local
APP_URL=http://localhost:3000
SESSION_SECRET=
CRON_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID_MONTHLY=
PAYPAL_PLAN_ID_YEARLY=
PAYPAL_WEBHOOK_ID=
MAIL_FROM=
# Betrieb (Hosting)
# Persistente Verzeichnisse außerhalb des Programmordners (sonst ./data und ./storage)
DATA_DIR=
STORAGE_DIR=
# Kommagetrennt; diese Adressen sehen den Prüfbereich
ADMIN_EMAILS=
# PORT setzt der Hoster (App lauscht auf HTTP, HTTPS übernimmt der Hoster)
PORT=3000
